# VET-AI Environment Configuration Example
# Replace placeholders with your actual secure credentials

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# PostgreSQL Database Connection (Supabase Transaction Pooler recommended)
DATABASE_URL=postgresql://postgres.your-project-id:your_password@aws-0-region.pooler.supabase.com:6543/postgres
DB_HOST=aws-0-region.pooler.supabase.com
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASS=your_db_password
DB_PORT=6543

# Artificial Intelligence Engine (Google Gemini / Vertex)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-3.8-flash

# Application Server Settings
PORT=8000
DEMO_MODE=true
